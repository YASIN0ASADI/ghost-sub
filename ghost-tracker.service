[Unit]
Description=Ghost Sub — Usage Tracker (Pasarguard)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ghost-tracker
ExecStart=/usr/bin/python3 /opt/ghost-tracker/tracker.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
